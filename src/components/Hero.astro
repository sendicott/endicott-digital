---
import ArrowUpRight from './ArrowUpRight.astro';
import { inquiryMailto } from '../data/site';
---

<section class="hero">
  <div class="eyebrow">INDEPENDENT SOFTWARE DEVELOPMENT · PENNSYLVANIA</div>
  <h1>Keep what works.<br /><span>Build what’s next.</span></h1>
  <div class="hero-bottom">
    <p>Modernize the software you rely on. Move your data with care. Make your systems work together.</p>
    <a class="button" href={inquiryMailto}>Tell Scott about your project <ArrowUpRight /></a>
  </div>
  <div class="index-line"><span>EXISTING SYSTEMS. NEW POSSIBILITIES.</span><span>01 — 04</span></div>
</section>
