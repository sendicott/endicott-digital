---
import { getImage } from 'astro:assets';
import logo from '../assets/new-growth.png';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

// The logo mark doubles as the favicon (as in the original), but resized
// instead of shipping the 640 KB master.
const favicon = await getImage({ src: logo, width: 128, format: 'png' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.themeColor} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={favicon.src} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
